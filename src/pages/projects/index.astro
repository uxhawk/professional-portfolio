---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProjectGrid from "@/components/ProjectGrid";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const gridProjects = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  thumbnail: p.data.thumbnail,
  tags: p.data.tags,
  date: p.data.date.toISOString(),
}));
---

<Base
  title="Projects - David Hawkins | Product Design"
  description="UX and product design case studies by David Hawkins: AI workflows, design systems, mobile apps, onboarding, and UX research."
>
  <div class="mx-auto max-w-6xl px-5 pt-8 md:px-8">
    <Breadcrumbs current="Projects" />
    <h1 class="sr-only">Projects</h1>
  </div>
  <div class="mx-auto max-w-6xl px-5 py-10 md:px-8 md:pb-24">
    <ProjectGrid client:load projects={gridProjects} filters />
  </div>
</Base>
