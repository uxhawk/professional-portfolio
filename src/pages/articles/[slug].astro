---
import { getCollection, render } from "astro:content";
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { Badge } from "@/components/ui/badge";

export async function getStaticPaths() {
  const articles = (await getCollection("articles")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return articles.map((article, i) => ({
    params: { slug: article.id },
    props: {
      article,
      // wrap around so the last article points back to the first
      next: articles[(i + 1) % articles.length],
      prev: i > 0 ? articles[i - 1] : null,
    },
  }));
}

const { article, next, prev } = Astro.props;
const { Content } = await render(article);
const { title, description, categories, heroImage } = article.data;
---

<Base
  title={`${title} - David Hawkins | Product Design`}
  description={description}
  ogImage={heroImage}
>
  <!-- Hero: fills the viewport below the sticky header (4rem mobile / 5rem desktop) -->
  <section class="relative flex min-h-[calc(100svh-4rem)] items-center overflow-hidden bg-neutral-900 md:min-h-[calc(100svh-5rem)]">
    {
      heroImage && (
        <img
          src={heroImage}
          alt=""
          class="absolute inset-0 h-full w-full object-cover opacity-60"
          loading="eager"
        />
      )
    }
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/60 to-black/35" aria-hidden="true"></div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-16 text-center md:px-8">
      <h1 class="font-display mx-auto max-w-3xl text-4xl font-extrabold tracking-tight text-white md:text-5xl">
        {title}
      </h1>
      {
        categories.length > 0 && (
          <div class="mt-6 flex flex-col items-center gap-2.5">
            <span class="font-sans text-sm font-bold text-white/85">Categories:</span>
            <div class="flex flex-wrap justify-center gap-2">
              {categories.map((category) => (
                <a
                  href={`/articles/#${category.toLowerCase().replace(/\s+/g, "-")}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${category} articles (opens in a new tab)`}
                >
                  <Badge className="rounded-full border-transparent bg-white font-sans text-neutral-900 hover:bg-white/85">
                    {category}
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                      <path d="M15 3h6v6M10 14 21 3" />
                    </svg>
                  </Badge>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Breadcrumbs (same padding geometry as the article body below) -->
  <div class="px-6 pt-8 md:px-16 lg:px-32 xl:px-80">
    <Breadcrumbs current={title} parent={{ label: "Articles", href: "/articles/" }} />
  </div>

  <!-- Article body -->
  <article class="prose-uxhawk px-6 py-10 md:px-16 md:py-14 lg:px-32 xl:px-80">
    <Content />
  </article>

  <!-- Previous / next article -->
  <nav class="mt-8 grid md:grid-cols-2" aria-label="Article navigation">
    {
      prev && (
        <a
          href={`/articles/${prev.id}/`}
          class="group relative flex min-h-[220px] items-center justify-center overflow-hidden bg-neutral-900 md:min-h-[280px]"
        >
          {prev.data.heroImage && (
            <img
              src={prev.data.heroImage}
              alt=""
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover opacity-50 transition-transform duration-500 group-hover:scale-[1.03]"
            />
          )}
          <div class="relative px-6 text-center">
            <p class="text-xs font-bold tracking-widest text-white/70 uppercase">Previous Article</p>
            <p class="mt-2 text-xl font-bold text-white md:text-2xl">{prev.data.title}</p>
          </div>
        </a>
      )
    }
    <a
      href={`/articles/${next.id}/`}
      class:list={[
        "group relative flex min-h-[220px] items-center justify-center overflow-hidden bg-neutral-900 md:min-h-[280px]",
        { "md:col-span-2": !prev },
      ]}
    >
      {
        next.data.heroImage && (
          <img
            src={next.data.heroImage}
            alt=""
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover opacity-50 transition-transform duration-500 group-hover:scale-[1.03]"
          />
        )
      }
      <div class="relative px-6 text-center">
        <p class="text-xs font-bold tracking-widest text-white/70 uppercase">Next Article</p>
        <p class="mt-2 text-xl font-bold text-white md:text-2xl">{next.data.title}</p>
      </div>
    </a>
  </nav>
</Base>
