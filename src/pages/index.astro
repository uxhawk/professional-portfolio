---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import PillButton from "@/components/PillButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectGrid from "@/components/ProjectGrid";
import { Badge } from "@/components/ui/badge";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order,
);
const gridProjects = projects.map((p) => ({
  slug: p.id,
  title: p.data.title,
  subtitle: p.data.subtitle,
  company: p.data.company,
  thumbnail: p.data.thumbnail,
  tags: p.data.tags,
  date: p.data.date.toISOString(),
}));

const articles = (await getCollection("articles"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const resultRows = [
  {
    slug: "human-in-the-loop-ai-review",
    metric: "55% faster delivery time",
    company: "Precedent",
    logo: "/images/companies/precedent.png",
    image: "/images/2026/03/human-in-the-loop.png",
  },
  {
    slug: "android-app-design",
    metric: "Shipped in under 100 days",
    company: "GEICO",
    logo: "/images/companies/geico.png",
    image: "/images/2021/12/hero-img.png",
  },
  {
    slug: "ai-document-authoring",
    metric: "22% fewer support tickets",
    company: "Precedent",
    logo: "/images/companies/precedent.png",
    image: "/images/2026/02/doc-editor.png",
  },
  {
    slug: "enterprise-design-system",
    metric: "20-app ecosystem",
    company: "insightsoftware",
    logo: "/images/companies/insightsoftware.png",
    image: "/images/2025/12/global-design-system.png",
  },
];

const results = resultRows.map((row) => {
  const project = projects.find((p) => p.id === row.slug);
  if (!project) throw new Error(`Proven Results references unknown project: ${row.slug}`);
  return {
    ...row,
    href: `/projects/${row.slug}/`,
    title: project.data.title,
    subtitle: project.data.subtitle,
    tags: project.data.tags,
  };
});

const experience = [
  { years: "2023 - 2026", role: "Principal Product Designer - Precedent" },
  { years: "2020 - 2023", role: "Senior Product Designer - insightsoftware" },
  { years: "2019 - 2020", role: "Product Designer - Booz Allen Hamilton (NSF)" },
  { years: "2015 - 2019", role: "Senior User Experience Designer - GEICO" },
  { years: "2013 - 2015", role: "User Experience Researcher - Fors Marsh Group" },
  { years: "2011 - 2013", role: "MA Human Factors and Applied Cognition - George Mason University" },
];
---

<Base>
  <!-- Hero: full-viewport height below the sticky header (4rem mobile / 5rem desktop),
       with the phone mockups as a full-bleed background behind the intro text -->
  <section class="relative flex min-h-[calc(100svh-4rem)] items-center overflow-hidden shadow-[0_1px_0_rgba(0,0,0,0.06)] md:min-h-[calc(100svh-5rem)]">
    <picture>
      <source media="(max-width: 767px)" srcset="/images/2026/08/iphones-centered.png" />
      <img
        src="/images/2026/02/iphones.png"
        alt=""
        class="absolute inset-0 h-full w-full object-cover object-center md:object-contain md:object-right"
        width="1728"
        height="807"
        loading="eager"
      />
    </picture>
    <div
      class="absolute inset-0 bg-white/90 md:bg-transparent md:bg-gradient-to-r md:from-white md:via-white/80 md:to-white/20"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto w-full max-w-6xl px-5 py-12 md:px-8">
      <h1 class="font-display text-5xl font-extrabold tracking-tight text-brand md:text-6xl">David Hawkins</h1>
    
      <p class="mt-2 max-w-md text-body">Principal Product Designer</p>
      <div class="mt-8">
        <PillButton href="#proven-results" icon="down">Explore portfolio</PillButton>
      </div>
    </div>
  </section>

  <!-- Proven Results -->
  <section class="scroll-mt-16 bg-white md:scroll-mt-20" id="proven-results">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <SectionHeading icon="badge">Proven Results</SectionHeading>
      <div class="flex flex-col divide-y divide-neutral-200">
        {
          results.map((r) => (
            <div class="grid items-center gap-6 py-10 first:pt-0 last:pb-0 md:grid-cols-3 md:gap-10 md:py-12">
              <div class="flex flex-col items-start gap-4">
                <div class="flex items-center gap-3">
                  <img
                    src={r.logo}
                    alt={`${r.company} logo`}
                    class="size-12 rounded-lg object-contain"
                    loading="lazy"
                  />
                  <span class="text-sm font-bold text-neutral-900">{r.company}</span>
                </div>
                <p class="flex items-start gap-2 font-bold text-neutral-900">
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    class="mt-0.5 shrink-0 text-green-600"
                    aria-hidden="true"
                  >
                    <circle cx="12" cy="12" r="10" fill="currentColor" />
                    <path
                      d="M7.5 12.5 10.5 15.5 16.5 9"
                      stroke="white"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                  {r.metric}
                </p>
                <h3 class="text-2xl font-bold text-neutral-900">{r.title}</h3>
                {r.subtitle && <p class="text-body">{r.subtitle}</p>}
                {
                  r.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {r.tags.map((tag) => (
                        <a
                          href={`/projects/#${tag.toLowerCase().replace(/\s+/g, "-")}`}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${tag} projects (opens in a new tab)`}
                        >
                          <Badge
                            variant="outline"
                            className="rounded-full text-body hover:border-brand hover:text-brand"
                          >
                            {tag}
                            <svg
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              aria-hidden="true"
                            >
                              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                              <path d="M15 3h6v6M10 14 21 3" />
                            </svg>
                          </Badge>
                        </a>
                      ))}
                    </div>
                  )
                }
                <PillButton href={r.href} variant="outline">View project</PillButton>
              </div>
              <a href={r.href} class="group block overflow-hidden rounded-lg md:col-span-2">
                <img
                  src={r.image}
                  alt={`${r.title} preview`}
                  loading="lazy"
                  class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About Me -->
  <section class="bg-band">
    <div class="mx-auto grid max-w-6xl gap-14 px-5 py-16 md:grid-cols-2 md:px-8 md:py-24">
    <div>
      <div class="flex items-center gap-5">
        <img
          src="/images/2026/07/RIZ03278-3-1.png"
          alt="Portrait of David Hawkins"
          class="size-16 rounded-full object-cover"
          width="300"
          height="300"
          loading="lazy"
        />
        <h2 class="text-3xl font-extrabold tracking-tight text-neutral-900 md:text-4xl">About Me</h2>
      </div>
      <p class="mt-4 text-body">
        Over the last 13 years I've led end-to-end product design, architected robust design
        systems, and driven UX strategy across complex, data-rich enterprise products.
      </p>
      <h3 class="mt-10 text-xl font-bold text-neutral-900">Certifications</h3>
      <img
        src="/images/2026/02/Frame-3.png"
        alt="NN/g UX Certified and HFI Certified Usability Analyst badges"
        class="mt-4 max-w-xs"
        loading="lazy"
      />
    </div>
    <div>
      <h3 class="text-xl font-bold text-neutral-900">Work Experience</h3>
      <ul class="mt-4 divide-y divide-neutral-200">
        {
          experience.map((e) => (
            <li class="grid grid-cols-[110px_1fr] gap-4 py-4">
              <span class="text-sm text-muted-foreground">{e.years}</span>
              <span class="text-sm font-bold text-neutral-900">{e.role}</span>
            </li>
          ))
        }
      </ul>
      </div>
    </div>
  </section>

  <!-- All Projects -->
  <section class="scroll-mt-16 bg-white md:scroll-mt-20" id="main-projects">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <SectionHeading icon="grid">All Projects</SectionHeading>
      <ProjectGrid client:load projects={gridProjects} filters />
    </div>
  </section>

  <!-- Articles -->
  <section class="bg-band">
    <div class="mx-auto max-w-6xl px-5 py-16 md:px-8 md:py-24">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <SectionHeading icon="doc">Articles</SectionHeading>
        <div class="mb-10">
          <PillButton href="/articles/">View All</PillButton>
        </div>
      </div>
      <div class="grid gap-5 md:grid-cols-2">
        {
          articles.map((a) => (
            <ArticleCard
              href={`/articles/${a.id}/`}
              title={a.data.title}
              excerpt={a.data.description}
              image={a.data.heroImage}
              categories={a.data.categories}
            />
          ))
        }
      </div>
    </div>
  </section>
</Base>
