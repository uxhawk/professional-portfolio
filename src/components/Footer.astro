---
import { SITE } from "@/site.config";
import PillButton from "@/components/PillButton.astro";

interface Props {
  hideCta?: boolean;
}
const { hideCta = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer>
  {
    !hideCta && (
      <section class="border-t border-neutral-200 bg-white">
        <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-5 py-16 text-center md:py-20">
          <p class="text-base text-body md:text-lg">
            Let's talk design, AI, and product strategy. Reach out anytime to collaborate or start a
            conversation.
          </p>
          <PillButton href="/contact/">Contact</PillButton>
        </div>
      </section>
    )
  }
  <div class="bg-brand">
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-5 py-6 text-sm text-white md:flex-row md:px-8"
    >
      <p>© {year} David Hawkins. All rights reserved.</p>
      <a
        href={SITE.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="David Hawkins on LinkedIn"
        class="text-white transition-colors hover:text-white/75"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.23 0z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</footer>