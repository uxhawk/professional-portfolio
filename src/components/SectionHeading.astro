---
/**
 * Section heading with the small outlined icon used on the homepage
 * ("Proven Results", "All Projects", "Articles").
 */
interface Props {
  icon: "badge" | "grid" | "doc" | "user";
  id?: string;
}
const { icon, id } = Astro.props;
---

<div class="mb-10 flex items-center gap-4" id={id}>
  <span
    class="flex size-14 shrink-0 items-center justify-center text-brand"
    aria-hidden="true"
  >
    {
      icon === "badge" && (
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="9" r="5.5" />
          <path d="M8.5 13.5 7 21l5-2.5L17 21l-1.5-7.5" stroke-linejoin="round" />
        </svg>
      )
    }
    {
      icon === "grid" && (
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3.5" y="3.5" width="7" height="7" rx="1" />
          <rect x="13.5" y="3.5" width="7" height="7" rx="1" />
          <rect x="3.5" y="13.5" width="7" height="7" rx="1" />
          <rect x="13.5" y="13.5" width="7" height="7" rx="1" />
        </svg>
      )
    }
    {
      icon === "doc" && (
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 3.5h8L19 8.5v12H6z" stroke-linejoin="round" />
          <path d="M14 3.5v5h5M9 12h6M9 15.5h6" />
        </svg>
      )
    }
    {
      icon === "user" && (
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="8" r="4" />
          <path d="M4.5 20.5c1.5-3.5 4.5-5 7.5-5s6 1.5 7.5 5" stroke-linecap="round" />
        </svg>
      )
    }
  </span>
  <h2 class="text-3xl font-extrabold tracking-tight text-neutral-900 md:text-4xl">
    <slot />
  </h2>
</div>
