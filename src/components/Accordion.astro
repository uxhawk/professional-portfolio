---
/**
 * Exclusive accordion: at most one child AccordionItem is open at a time;
 * clicking the open item's header closes it (all items may be collapsed).
 *
 * Usage (MDX):
 *   import Accordion from "../../components/Accordion.astro";
 *   import AccordionItem from "../../components/AccordionItem.astro";
 *
 *   <Accordion>
 *     <AccordionItem title="Section title" duration="5 min">
 *       …markdown content…
 *     </AccordionItem>
 *   </Accordion>
 */
---

<div class="accordion not-prose-chrome" data-accordion>
  <slot />
</div>

<style>
  .accordion {
    border: 1px solid var(--color-neutral-200, #e5e5e5);
    border-radius: 0.75rem;
    background: white;
    margin-block: 2rem;
    overflow: hidden;
  }
  .accordion :global([data-accordion-item] + [data-accordion-item]) {
    border-top: 1px solid var(--color-neutral-200, #e5e5e5);
  }
  /* External links in panels open in a new tab (set in the script below);
     mirror the hero-badge external-link icon, inheriting link color via mask */
  .accordion :global([data-accordion-panel] a[href^="http"])::after {
    content: "";
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    margin-left: 0.3em;
    vertical-align: -0.05em;
    background-color: currentColor;
    -webkit-mask: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'/%3E%3Cpath d='M15 3h6v6M10 14 21 3'/%3E%3C/svg%3E") no-repeat center / contain;
    mask: url("data:image/svg+xml;utf8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'/%3E%3Cpath d='M15 3h6v6M10 14 21 3'/%3E%3C/svg%3E") no-repeat center / contain;
  }
</style>

<script>
  function initAccordion(root: HTMLElement) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-accordion-item]")];

    // External links inside panels open in a new tab, with an accessible hint
    // (the matching icon is added in CSS above)
    for (const a of root.querySelectorAll<HTMLAnchorElement>(
      '[data-accordion-panel] a[href^="http"]',
    )) {
      a.target = "_blank";
      a.rel = "noopener noreferrer";
      a.setAttribute("aria-label", `${a.textContent?.trim()} (opens in a new tab)`);
    }

    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle("open", open);
      item
        .querySelector("[data-accordion-trigger]")
        ?.setAttribute("aria-expanded", String(open));
    };

    for (const item of items) {
      item
        .querySelector<HTMLButtonElement>("[data-accordion-trigger]")
        ?.addEventListener("click", () => {
          const wasOpen = item.classList.contains("open");
          for (const other of items) setOpen(other, false);
          if (!wasOpen) setOpen(item, true);
        });
    }
  }

  document.querySelectorAll<HTMLElement>("[data-accordion]").forEach(initAccordion);
</script>
