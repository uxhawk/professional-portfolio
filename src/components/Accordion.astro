---
/**
 * Exclusive accordion: at most one child AccordionItem is open at a time;
 * clicking the open item's header closes it (all items may be collapsed).
 *
 * Usage (MDX):
 *   import Accordion from "../../components/Accordion.astro";
 *   import AccordionItem from "../../components/AccordionItem.astro";
 *
 *   <Accordion>
 *     <AccordionItem title="Section title" duration="5 min">
 *       …markdown content…
 *     </AccordionItem>
 *   </Accordion>
 */
---

<div class="accordion not-prose-chrome" data-accordion>
  <slot />
</div>

<style>
  .accordion {
    border: 1px solid var(--color-neutral-200, #e5e5e5);
    border-radius: 0.75rem;
    background: white;
    margin-block: 2rem;
    overflow: hidden;
  }
  .accordion :global([data-accordion-item] + [data-accordion-item]) {
    border-top: 1px solid var(--color-neutral-200, #e5e5e5);
  }
</style>

<script>
  function initAccordion(root: HTMLElement) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-accordion-item]")];

    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle("open", open);
      item
        .querySelector("[data-accordion-trigger]")
        ?.setAttribute("aria-expanded", String(open));
    };

    for (const item of items) {
      item
        .querySelector<HTMLButtonElement>("[data-accordion-trigger]")
        ?.addEventListener("click", () => {
          const wasOpen = item.classList.contains("open");
          for (const other of items) setOpen(other, false);
          if (!wasOpen) setOpen(item, true);
        });
    }
  }

  document.querySelectorAll<HTMLElement>("[data-accordion]").forEach(initAccordion);
</script>
