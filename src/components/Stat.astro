---
/**
 * One survey result inside a StatGrid: a large brand-blue score with the
 * survey statement centered beneath it, then the interpretation (slot) as
 * regular left-aligned body text styled by the surrounding prose class.
 */
interface Props {
  value: string;
  label: string;
}
const { value, label } = Astro.props;
---

<section class="stat">
  <p class="value">{value}</p>
  <p class="label">{label}</p>
  <div class="body"><slot /></div>
</section>

<style>
  .value {
    margin: 0;
    font-size: clamp(3.25rem, 6vw, 4.25rem);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
    color: var(--brand);
  }
  .label {
    margin: 0.375rem 0 0;
    text-align: center;
    font-size: 1rem;
    color: var(--color-neutral-800, #262626);
  }
  .body {
    margin-top: 1.5rem;
  }
  .body > :global(:first-child) {
    margin-top: 0;
  }
  .body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
