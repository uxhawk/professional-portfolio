---
/**
 * Brand pill button used across the site ("Explore portfolio", "Contact", "View All").
 * Matches the Salient nectar-button look: navy pill, white text, arrow circle.
 * `icon="down"` suits in-page scroll targets; the default right arrow suits navigation.
 */
interface Props {
  href: string;
  icon?: "right" | "down";
  /** "solid" navy pill (default) or "outline" secondary style */
  variant?: "solid" | "outline";
  class?: string;
}
const { href, icon = "right", variant = "solid", class: className = "" } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group inline-flex items-center gap-3 rounded-full py-2.5 pr-2.5 pl-6 text-sm font-bold transition-colors",
    variant === "solid"
      ? "bg-brand text-white hover:bg-brand-dark"
      : "border border-brand bg-transparent text-brand hover:bg-brand hover:text-white",
    className,
  ]}
>
  <slot />
  <span
    class:list={[
      "flex size-7 items-center justify-center rounded-full transition-[transform,background-color]",
      variant === "solid" ? "bg-white/15" : "bg-brand/10 group-hover:bg-white/15",
      icon === "down" ? "group-hover:translate-y-0.5" : "group-hover:translate-x-0.5",
    ]}
    aria-hidden="true"
  >
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class:list={[icon === "down" && "rotate-90"]}>
      <path
        d="M3 8h10M9 4l4 4-4 4"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </span>
</a>
